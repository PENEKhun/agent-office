{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Office",
  "version": "0.4.1",
  "identifier": "local.agent-office.widget",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Office Widget",
        "url": "about:blank",
        "width": 420,
        "height": 300,
        "minWidth": 300,
        "minHeight": 64,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["widget-remote"],
      "csp": "default-src 'self' http://127.0.0.1:4777 http://127.0.0.1:4778 http://127.0.0.1:4779 http://127.0.0.1:4780 http://127.0.0.1:4781 http://127.0.0.1:4782 http://127.0.0.1:4783 http://127.0.0.1:4784 http://127.0.0.1:4785 http://127.0.0.1:4786 http://127.0.0.1:4787; img-src 'self' data: http://127.0.0.1:4777 http://127.0.0.1:4778 http://127.0.0.1:4779 http://127.0.0.1:4780 http://127.0.0.1:4781 http://127.0.0.1:4782 http://127.0.0.1:4783 http://127.0.0.1:4784 http://127.0.0.1:4785 http://127.0.0.1:4786 http://127.0.0.1:4787; style-src 'self' 'unsafe-inline' http://127.0.0.1:4777 http://127.0.0.1:4778 http://127.0.0.1:4779 http://127.0.0.1:4780 http://127.0.0.1:4781 http://127.0.0.1:4782 http://127.0.0.1:4783 http://127.0.0.1:4784 http://127.0.0.1:4785 http://127.0.0.1:4786 http://127.0.0.1:4787; script-src 'self' 'unsafe-inline' http://127.0.0.1:4777 http://127.0.0.1:4778 http://127.0.0.1:4779 http://127.0.0.1:4780 http://127.0.0.1:4781 http://127.0.0.1:4782 http://127.0.0.1:4783 http://127.0.0.1:4784 http://127.0.0.1:4785 http://127.0.0.1:4786 http://127.0.0.1:4787; connect-src ipc: http://ipc.localhost http://127.0.0.1:4777 http://127.0.0.1:4778 http://127.0.0.1:4779 http://127.0.0.1:4780 http://127.0.0.1:4781 http://127.0.0.1:4782 http://127.0.0.1:4783 http://127.0.0.1:4784 http://127.0.0.1:4785 http://127.0.0.1:4786 http://127.0.0.1:4787"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../../server.js": "server/server.js",
      "../../src": "server/src",
      "../../public": "server/public",
      "../../config.example.json": "server/config.example.json"
    }
  }
}
